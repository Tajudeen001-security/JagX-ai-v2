# ============================================================================
#  JagX v13 — environment
#  Copy to .env and edit.  NOTHING here is required to start the app:
#  with no configuration at all it runs against a local Ollama on :11434,
#  and the multimodal engine runs on its built-in local fallback.
# ============================================================================

# --- auth -------------------------------------------------------------------
# REQUIRED in production. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JAGX_JWT_SECRET=
JAGX_JWT_TTL_HOURS=336
JAGX_ALLOW_SIGNUP=true

# --- storage ----------------------------------------------------------------
JAGX_DATA_DIR=data

# --- agent ------------------------------------------------------------------
JAGX_MAX_STEPS=12
JAGX_MAX_TOKENS=2048
JAGX_TEMPERATURE=0.4
JAGX_LLM_TIMEOUT=120
JAGX_TOOL_TIMEOUT=30
JAGX_MAX_HISTORY=30
JAGX_MAX_TOOL_OUTPUT=6000
JAGX_CRITIQUE_PASSES=2
JAGX_COUNCIL_LANES=3

# --- local-first inference (NO API KEY NEEDED) ------------------------------
# Ollama is the default.  `ollama pull qwen2.5:7b` then `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# llama.cpp / llama-server:  ./llama-server -m model.gguf --port 8080
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-gguf

# vLLM:  vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- OPTIONAL third-party endpoints (off unless you set a key) --------------
# JagX never requires these.  They are pluggable extras, not dependencies.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- tools ------------------------------------------------------------------
# Web search works with NO key (keyless DuckDuckGo).  A key just improves it.
TAVILY_API_KEY=
SERPER_API_KEY=
JAGX_ENABLE_WEB_TOOLS=true

# --- sandbox ----------------------------------------------------------------
JAGX_ENABLE_CODE_EXECUTION=true
JAGX_SANDBOX_TIMEOUT=10
JAGX_SANDBOX_MEMORY_MB=512
JAGX_SANDBOX_ALLOW_NETWORK=false
# Optional stronger isolation; leave empty to use the built-in local sandbox.
JAGX_PISTON_URL=

# --- embeddings -------------------------------------------------------------
# "auto" uses sentence-transformers when installed, else the built-in hashed
# embedder (zero dependencies, works offline).
JAGX_EMBEDDING_BACKEND=auto
JAGX_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- multimodal: image generation (LOCAL, FREE, NO API KEY) -----------------
# Tier 1: a local diffusers checkpoint.  Install with:
#   pip install torch diffusers accelerate
# Then set JAGX_IMAGE_MODEL to any local SD / SDXL / FLUX repo or path.
JAGX_IMAGE_MODEL=stabilityai/sd-turbo
# Optional separate inpainting checkpoint; empty reuses JAGX_IMAGE_MODEL.
JAGX_INPAINT_MODEL=
JAGX_IMAGE_NEGATIVE=blurry, low quality, watermark, text
JAGX_IMAGE_GUIDANCE=7.0
JAGX_IMAGE_MAX_SIDE=1024
JAGX_IMAGE_TIMEOUT=300
# Use the diffusion inpaint pipeline when available (falls back automatically).
JAGX_ENABLE_DIFFUSION_EDIT=true

# Tier 1 alternative: a local ComfyUI server.  Leave empty to skip.
#   JAGX_COMFYUI_URL=http://localhost:8188
JAGX_COMFYUI_URL=
JAGX_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# --- multimodal: vision (LOCAL, FREE, NO API KEY) ---------------------------
# A local vision-language model on an OpenAI-compatible endpoint.
#   ollama pull llava   then   JAGX_VISION_MODEL=llava
# Empty = use OCR + structural analysis instead.
JAGX_VISION_MODEL=
JAGX_VISION_BASE_URL=
JAGX_VISION_TIMEOUT=120

# --- multimodal: documents & OCR --------------------------------------------
# OCR needs the tesseract binary:  apt-get install tesseract-ocr
JAGX_OCR_TIMEOUT=60
JAGX_DOC_TIMEOUT=60
JAGX_DOC_MAX_CHARS=40000
JAGX_DOC_MAX_BYTES=2000000
JAGX_DOC_MAX_ROWS=500
JAGX_UPLOAD_MAX_BYTES=25000000

# --- server -----------------------------------------------------------------
PORT=8000
JAGX_CORS_ORIGINS=
