# GitHub App OAuth and secure repository execution
# Create a GitHub App; grant repository Contents: Read and write and Metadata: Read.
# Install the app only on repositories each user wants JagX AI to access.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://jagx-ai-v2.onrender.com/github/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_CONNECTION_DB=github_connections.sqlite3
JAGX_FRONTEND_URL=https://jagxai.name.ng

# Existing Supabase Auth settings used to validate the signed-in JagX AI user
SUPABASE_URL=
SUPABASE_ANON_KEY=
